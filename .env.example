# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Required)
# Local MongoDB: mongodb://localhost:27017/coursemaster
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/coursemaster?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/coursemaster

# JWT Authentication (Required)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Configuration
ADMIN_EMAIL=admin@coursemaster.com
ADMIN_REGISTRATION_KEY=your-secret-admin-key-here

# Client Application URL
FRONTEND_URL=http://localhost:5173

# Email Service (Optional - app will still work without these)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
